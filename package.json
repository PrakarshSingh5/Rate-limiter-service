{
  "name": "@prakarsh/rate-limiter",
  "version": "1.0.0",
  "description": "Production-ready API Rate Limiting & Quota Management - Use as a library or standalone service",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "bin": {
    "rate-limiter": "dist/cli.js"
  },
  "files": [
    "dist",
    "client",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "require": "./dist/lib/index.js",
      "import": "./dist/lib/index.js"
    },
    "./client": {
      "types": "./dist/client/rest-client.d.ts",
      "require": "./dist/client/rest-client.js",
      "import": "./dist/client/rest-client.js"
    },
    "./middleware/express": {
      "types": "./dist/lib/middleware/express.d.ts",
      "require": "./dist/lib/middleware/express.js",
      "import": "./dist/lib/middleware/express.js"
    },
    "./middleware/fastify": {
      "types": "./dist/lib/middleware/fastify.d.ts",
      "require": "./dist/lib/middleware/fastify.js",
      "import": "./dist/lib/middleware/fastify.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && chmod +x dist/cli.js",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "docker:build": "docker build -f docker/Dockerfile -t rate-limiter .",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down"
  },
  "keywords": [
    "rate-limiting",
    "rate-limiter",
    "api-gateway",
    "quota-management",
    "redis",
    "microservice",
    "token-bucket",
    "sliding-window",
    "express-middleware",
    "fastify-plugin",
    "distributed-rate-limiting"
  ],
  "author": "Prakarsh Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PrakarshSingh5/rate-limiter-service.git"
  },
  "bugs": {
    "url": "https://github.com/PrakarshSingh5/rate-limiter-service/issues"
  },
  "homepage": "https://github.com/PrakarshSingh5/rate-limiter-service#readme",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@grpc/grpc-js": "^1.10.1",
    "@grpc/proto-loader": "^0.7.10",
    "axios": "^1.6.7",
    "bull": "^4.12.2",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.2",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
